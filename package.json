{
  "name": "obsidian-ribbon-bookmarks",
  "version": "1.3.1",
  "description": "Everything you reach for often, one click away in the left sidebar: web links, any file, nested folders and drag and drop.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --no-warn-ignored && stylelint styles.css",
    "deploy": "npm run build && cp manifest.json main.js styles.css \"$OBSIDIAN_VAULT_PLUGINS/ribbon-bookmarks/\""
  },
  "keywords": [
    "obsidian",
    "ribbon",
    "bookmarks",
    "folders"
  ],
  "license": "MIT",
  "author": "Bryan Monge",
  "repository": {
    "type": "git",
    "url": "https://github.com/bryanmongesolano/obsidian-ribbon-bookmarks.git"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.47.0"
  }
}
